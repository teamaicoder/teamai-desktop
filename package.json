{
  "name": "teamaicoder",
  "productName": "TeamAICoder",
  "version": "1.0.0",
  "description": "Open-source desktop workbench for running many software projects with AI coding agents",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "setup": "node scripts/copy-vendor.js",
    "test": "jest --runInBand --testPathIgnorePatterns=tests/ui",
    "test:ui": "playwright test",
    "dist": "electron-builder --mac",
    "postinstall": "electron-rebuild -f"
  },
  "build": {
    "appId": "com.teamaicoder.app",
    "productName": "TeamAICoder",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dir"
    },
    "files": [
      "main.js",
      "preload.js",
      "main/**/*",
      "renderer/**/*",
      "scripts/**/*",
      "node_modules/**/*",
      "!node_modules/.cache",
      "!**/*.map"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/ui/"
    ]
  },
  "dependencies": {
    "@toast-ui/editor": "^2.5.4",
    "easymde": "^2.21.0",
    "marked": "^12.0.0",
    "node-pty": "^1.0.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.60.0",
    "electron": "^44.10.0",
    "electron-builder": "^26.8.1",
    "electron-reload": "^2.0.0-alpha.1",
    "jest": "^30.4.2",
    "playwright": "^1.60.0"
  }
}
