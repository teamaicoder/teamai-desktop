{
  "name": "teamaicoder",
  "productName": "TeamAICoder",
  "version": "1.0.0",
  "description": "File browser, editor, and terminal",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "setup": "node scripts/copy-vendor.js",
    "test": "jest --runInBand",
    "postinstall": "electron-rebuild -f"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "@toast-ui/editor": "^2.5.4",
    "easymde": "^2.21.0",
    "marked": "^12.0.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-rebuild": "^3.2.9",
    "electron-reload": "^2.0.0-alpha.1",
    "jest": "^30.4.2"
  }
}
